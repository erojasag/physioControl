NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database (Render Postgres)
DATABASE_URL=postgresql://user:pass@localhost:5432/physio
DIRECT_URL=postgresql://user:pass@localhost:5432/physio

# Cache + queue (Render Key Value)
REDIS_URL=redis://localhost:6379

# Auth (Clerk) — backend
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Local dev only: skip Clerk, trust `x-dev-user: <clerkUserId>` header. Never in prod.
AUTH_DEV_BYPASS=false

# Storage (R2/S3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Messaging
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Payments (Onvo)
ONVO_API_KEY=
ONVO_WEBHOOK_SECRET=
ONVO_BASE_URL=https://api.onvopay.com

# Observability
SENTRY_DSN=
